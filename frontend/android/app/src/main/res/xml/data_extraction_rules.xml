<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12 and higher
     (android:dataExtractionRules). See backup_rules.xml for why the secure
     storage file is excluded; keep the two files in sync. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
