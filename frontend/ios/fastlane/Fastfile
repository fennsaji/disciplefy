# Fastlane lanes for the Disciplefy iOS app.
#
# Build model: Flutter compiles the Dart/iOS code in the CI step BEFORE fastlane
# runs (`flutter build ios --release --no-codesign --dart-define=...`), which writes
# DART_DEFINES + version into ios/Flutter/Generated.xcconfig. `build_app` (gym) then
# re-archives the workspace, reusing those defines, and signs with the match profile.
#
# Auth is via the App Store Connect API key (no Apple ID / 2FA needed in CI).

# `xcodebuild -showBuildSettings` (run internally by build_app/gym before the
# archive) has timed out on GitHub-hosted macOS runners under load — a runner
# resource-contention flake, not a project config problem (seen 4 Sept 2026:
# match succeeded, update_code_signing_settings succeeded, build_app died here
# at the very first xcodebuild call). fastlane exposes exactly these two env
# vars for it; raise both rather than accept the 3s/4-retry default on CI.
ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "10"
ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] ||= "6"

default_platform(:ios)

APP_IDENTIFIER = "com.disciplefy.biblestudy"
TEAM_ID        = "4V6VA2U9MW"
WORKSPACE      = "Runner.xcworkspace"
SCHEME         = "Runner"
MATCH_PROFILE  = "match AppStore #{APP_IDENTIFIER}"

platform :ios do
  before_all do
    # On CI: create a temporary keychain so match can install the signing identity.
    setup_ci if ENV["CI"]
  end

  desc "Build and upload a new build to TestFlight"
  lane :beta do
    api_key = asc_api_key
    install_signing(api_key)
    build_ios
    upload_crashlytics_symbols
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build and upload to App Store Connect (no auto-submit)"
  lane :release do
    api_key = asc_api_key
    install_signing(api_key)
    build_ios
    upload_crashlytics_symbols
    upload_to_app_store(
      api_key: api_key,
      submit_for_review: false,
      automatic_release: false,
      force: true,               # skip HTML preview
      skip_metadata: true,       # metadata managed in App Store Connect UI
      skip_screenshots: true,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Backfill Crashlytics dSYMs for already-shipped builds (fixes 'Missing dSYM')"
  desc "Usage: fastlane refresh_dsyms version:1.0.1 build:18472  (omit both for all)"
  lane :refresh_dsyms do |options|
    api_key = asc_api_key
    download_dsyms(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: options[:version] || "latest",
      build_number: options[:build]
    )
    paths = lane_context[SharedValues::DSYM_PATHS] || []
    UI.user_error!("Apple has no dSYMs for this build (bitcode disabled — nothing to backfill)") if paths.empty?
    binary = crashlytics_upload_symbols_binary
    UI.user_error!("upload-symbols not found — run `flutter build ios` first so Swift Package Manager resolves Firebase") unless binary
    paths.each do |dsym|
      upload_symbols_to_crashlytics(
        dsym_path: dsym,
        gsp_path: "Runner/GoogleService-Info.plist",
        binary_path: binary
      )
    end
    clean_build_artifacts
  end

  # --- helpers -------------------------------------------------------------

  def asc_api_key
    # Decode the base64 .p8 to a real file. Spaceship (match) can use key_content,
    # but altool (upload_to_testflight) needs the key as a PEM file on disk —
    # handing it the base64 string causes "file isn't in the correct format (259)".
    require "base64"
    require "tmpdir"
    key_path = File.expand_path("fastlane_asc_api_key.p8", Dir.tmpdir)
    File.write(key_path, Base64.decode64(ENV["APP_STORE_CONNECT_API_KEY_BASE64"]))
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false
    )
  end

  def install_signing(api_key)
    # GitHub-hosted macOS runners hit a known fastlane-match race here: right
    # after `security import`, the runner's `security set-key-partition-list`
    # step sometimes can't find the identity it just imported yet
    # ("SecItemCopyMatching: The specified item could not be found in the
    # keychain") and match aborts with "no local code signing identities
    # found" — even though the cert really is in the keychain a moment later.
    # Not a signing/credentials problem: both times this hit in CI (3 and
    # 4 Sept 2026), a bare manual rerun of the same job succeeded immediately.
    # Retry in-process instead of needing a human to notice and rerun.
    attempts = 0
    begin
      attempts += 1
      match(
        type: "appstore",
        readonly: true,
        api_key: api_key,
        app_identifier: APP_IDENTIFIER
      )
    rescue => e
      if attempts < 3
        UI.important("match failed (attempt #{attempts}/3), likely the keychain-import race — retrying: #{e.message}")
        sleep(5)
        retry
      end
      raise
    end
  end

  def build_ios
    # The project ships with automatic signing, which on CI tries to create a
    # *development* profile and needs a logged-in Apple ID. Switch the Runner
    # target to manual signing so the archive uses the match distribution profile.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: MATCH_PROFILE,
      bundle_identifier: APP_IDENTIFIER,
      targets: ["Runner"]
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      # Pin SPM checkout dir so it matches the earlier `flutter build ios` resolution —
      # otherwise gym re-resolves packages into DerivedData and
      # crashlytics_upload_symbols_binary's SPM path guess can silently miss.
      cloned_source_packages_path: "../build/ios/SourcePackages",
      # Flutter already compiled via `flutter build ios --no-codesign`; gym re-archives.
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => MATCH_PROFILE }
      }
    )
  end

  # Upload the archive's dSYMs to Firebase Crashlytics so iOS crashes get
  # symbolicated. Neither upload_to_testflight nor upload_to_app_store does this
  # — without it Crashlytics reports "Missing dSYM". Bitcode is disabled, so the
  # archive dSYM UUID matches the shipped binary and is the authoritative source.
  #
  # `upload-symbols` location depends on how Firebase is integrated. Since the
  # Flutter 3.44 project migration Firebase resolves via Swift Package Manager,
  # so the CocoaPods path no longer exists — hence the candidate list below.
  # Symbol upload is best-effort: a missing binary or a failed upload must never
  # fail a release that has already produced a valid IPA.
  def crashlytics_upload_symbols_binary
    candidates = [
      # Swift Package Manager (current): flutter build ios resolves packages here.
      "../build/ios/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols",
      # CocoaPods (pre-3.44 projects, and any future revert).
      "./Pods/FirebaseCrashlytics/upload-symbols"
    ]
    found = candidates.find { |path| File.exist?(path) }
    return found if found

    # The exact layout has moved between Xcode, Flutter and SPM versions, and a
    # miss here is silent — four shipped builds had no symbols before this was
    # checked at all. So search the trees the binary can plausibly be in rather
    # than guessing one more fixed path.
    roots = [
      "../build",                                    # flutter build ios output
      "./build",                                     # gym's own derived data
      "./Pods",                                      # CocoaPods
      File.expand_path("~/Library/Developer/Xcode/DerivedData"),
    ]
    roots.each do |root|
      next unless Dir.exist?(root)
      hit = Dir.glob("#{root}/**/Crashlytics/upload-symbols").first
      return hit if hit
    end

    UI.error("upload-symbols not found. Searched: #{roots.join(', ')} (cwd #{Dir.pwd})")
    nil
  end

  # Every dSYM worth uploading for this build.
  #
  # gym's DSYM_OUTPUT_PATH is one zip and is not always set; the archive always
  # has the real thing. Both are checked because a build that uploads no symbols
  # still ships happily, and the gap only surfaces weeks later as unreadable
  # crashes in the Crashlytics console.
  def crashlytics_dsym_paths
    paths = []

    zipped = lane_context[SharedValues::DSYM_OUTPUT_PATH]
    paths << zipped if zipped && File.exist?(zipped)

    archive = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    if archive && Dir.exist?(File.join(archive, "dSYMs"))
      paths.concat(Dir.glob(File.join(archive, "dSYMs", "*.dSYM")))
    end

    paths.uniq
  end

  # Marker the CI job reads. A skipped upload must not fail the build — the app
  # is already signed and shippable by this point — but it must not pass in
  # silence either, which is exactly how 1.0.3 through 1.0.5 shipped unreadable.
  # Resolved from this file's directory (ios/fastlane), so it lands in
  # frontend/build/ios — the path the workflow's verification step reads. The
  # first version was one level short and wrote into ios/build/ios, which does
  # not exist, so the marker never appeared and the job failed with "the upload
  # step never ran" even when it had.
  SYMBOL_UPLOAD_MARKER = "../../build/ios/crashlytics-symbols.status".freeze

  def record_symbol_status(status)
    path = File.expand_path(SYMBOL_UPLOAD_MARKER, __dir__)
    require "fileutils"
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, status)
    UI.message("Recorded Crashlytics symbol status at #{path}: #{status}")
  rescue StandardError => e
    UI.error("Could not write the symbol-upload marker: #{e.message}")
  end

  def upload_crashlytics_symbols
    dsyms = crashlytics_dsym_paths
    if dsyms.empty?
      UI.error("No dSYM found in gym output or the archive — Crashlytics upload skipped. Run `fastlane refresh_dsyms` afterwards.")
      record_symbol_status("skipped: no dSYM produced")
      return
    end

    # A nil binary is not the end: fastlane can locate the tool itself for a
    # CocoaPods layout. Try that before giving up, and only record a skip when
    # the upload genuinely cannot run.
    binary = crashlytics_upload_symbols_binary
    UI.message(binary ? "Using Crashlytics upload-symbols at #{binary}" : "Letting fastlane locate upload-symbols")

    failures = []
    dsyms.each do |dsym|
      options = {
        dsym_path: dsym,
        gsp_path: "Runner/GoogleService-Info.plist",
      }
      options[:binary_path] = binary if binary
      upload_symbols_to_crashlytics(**options)
    rescue StandardError => e
      # Crash symbolication is valuable but not worth failing a shippable build —
      # surface loudly instead, and let the CI guard turn it into a red job.
      UI.error("Crashlytics symbol upload failed for #{File.basename(dsym)}: #{e.message}")
      failures << File.basename(dsym)
    end

    if failures.empty?
      UI.success("Uploaded #{dsyms.count} dSYM(s) to Crashlytics")
      record_symbol_status("ok: uploaded #{dsyms.count} dSYM(s)")
    else
      record_symbol_status("failed: #{failures.join(', ')}")
    end
  end
end
