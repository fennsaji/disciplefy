          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "DD2tt",
          "name": "b",
          "fill": "#333333",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A single swipeable focus card (verse → review → continue) with a card-stack peek and dots. Below it, Up next is a plain 3-row list. No section headers, no carousel, no For You block.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "ykywx",
          "name": "c",
          "fill": "#6B6B6B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Calmest and most mobile-native. Verse is huge and unmissable. Risk: discovery of new paths drops — relies on the Topics tab.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 11.5,
          "fontWeight": "normal",
          "fontStyle": "italic"
        }
      ]
    },
