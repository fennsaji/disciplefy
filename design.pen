          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "gEVgl",
          "name": "Body",
          "fill": "#444444",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The streak chip takes brand gold. Gold now recurs, and the logo belongs to a family. Also fixes a real bug: that chip was purple-on-purple at 1.63:1; gold on the card is 3.05:1.",
