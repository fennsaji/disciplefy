          "name": "Body",
          "fill": "#444444",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "B plus a gold hairline under the header, a gold rail on the Today card, and gold for the active tab. Most committed to gold+indigo as a deliberate pair — but risks gold losing its meaning.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        }
