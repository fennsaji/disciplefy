          "content": "H1 — Atmosphere",
          "fontFamily": "Poppins",
          "fontSize": 18,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "eH5AS",
          "name": "s",
          "fill": "#555555",
          "content": "Today's order, prettier",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "DbLcg",
          "name": "b",
          "fill": "#333333",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "A radial indigo glow behind the header sets the mood; the verse is typeset directly on the page (no card) with pill actions. Streak, review and path progress sit as three small stats. Learning paths are a peeking carousel, and a slim Continue row replaces the big Explore button.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "tacG9",
          "name": "c",
          "fill": "#6B6B6B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Lowest risk — same information architecture as shipped, mostly styling. Biggest visual lift for least code.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 11.5,
          "fontWeight": "normal",
          "fontStyle": "italic"
        }
      ]
    },
    {
      "type": "frame",
      "id": "ZlYQE",
      "x": 450,
      "y": 12460,
      "name": "Note4 H2 — The shelf",
      "width": 390,
      "height": 230,
      "fill": "#00000000",
      "layout": "vertical",
      "gap": 6,
      "children": [
        {
          "type": "text",
          "id": "w9qwT",
          "name": "t",
          "fill": "#111111",
          "content": "H2 — The shelf",
          "fontFamily": "Poppins",
          "fontSize": 18,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "EUEwb",
          "name": "s",
          "fill": "#555555",
          "content": "Paths as books",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "kahM8",
          "name": "b",
          "fill": "#333333",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "The verse becomes a compact card; the hero is Your shelf: a 2×2 grid of learning paths drawn as book covers. Each spine is a progress bar in gold, the current book has a gold edge. Feels like a personal library, not a feed.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "qHD4Z",
          "name": "c",
          "fill": "#6B6B6B",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Best for retention once a user has 2+ paths. Needs an empty-shelf state with 2 suggested books. Explore button becomes Browse all.",
          "lineHeight": 1.45,
          "fontFamily": "Inter",
          "fontSize": 11.5,
          "fontWeight": "normal",
          "fontStyle": "italic"
        }
      ]
    },
    {
      "type": "frame",
