          "name": "v",
          "fill": "#777777",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "Densest — everything above the fold, no scrolling for the core. Most modern-looking. Risk: can feel busy, and tiles compete unless the sizing hierarchy is strictly held.",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 11,
          "fontWeight": "normal"
        }
      ]
    },
